# Copy to .env and replace placeholders. Configuration is validated at server
# startup; errors name the offending variables but never print their values.
# Required sets: test = DATABASE_URL; development = DATABASE_URL,
# BETTER_AUTH_SECRET, BETTER_AUTH_URL, FRONTEND_URL, GITHUB_CLIENT_ID,
# GITHUB_CLIENT_SECRET; production = all of those plus DATABASE_CA_CERT.

NODE_ENV=development
PORT=3000

# Postgres connection string (postgres:// or postgresql://).
DATABASE_URL=postgresql://user:password@host:5432/database

# Trusted Postgres CA certificate in PEM form; use literal \n separators when
# storing it on one line. Required in production; with no CA material, TLS
# verification is skipped in development/test only.
DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# TLS server-name override. Required for IP-address DATABASE_URL values when
# TLS verification is enabled (startup fails without it); set it to the
# identity the server certificate carries as a SAN. Ignored for DNS hostnames,
# which node-postgres verifies against the connection host — for those, the
# certificate must carry that DNS name as a SAN.
DATABASE_TLS_SERVERNAME=

# Omit both GitHub values in NODE_ENV=test to disable the provider.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:5173
GITHUB_CLIENT_ID=replace-with-github-oauth-client-id
GITHUB_CLIENT_SECRET=replace-with-github-oauth-client-secret
FRONTEND_URL=http://localhost:5173
# Comma-separated better-auth admin user IDs; empty means no admins.
ADMIN_USER_IDS=

# Local scrape script only. API_URL must be HTTPS unless it points to a
# loopback host. Create the API key once in Settings; it is shown only once.
API_URL=http://localhost:3000
API_KEY=replace-with-generated-api-key

# Disposable database for integration tests. Never development or production:
# setup applies all migrations and wipes its tables. Append ?sslmode=disable
# when the test server does not support TLS.
TEST_DATABASE_URL=postgresql://user:password@host:5432/fragtest
