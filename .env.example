DATABASE_URL=postgresql://user:password@host:5432/database
# PEM certificate content; use literal \n separators when storing it on one line.
# Required in production: startup fails when it is missing or malformed.
# Without it (development only) the connection skips certificate verification.
DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# Optional TLS server-name override. Only applies when DATABASE_URL uses an IP
# address (node-postgres verifies DNS hostnames against the connection host).
# The server certificate must carry the connection hostname as a SAN.
DATABASE_TLS_SERVERNAME=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
# Create once in Settings. The full value cannot be retrieved later.
API_KEY=
# Disposable database for integration tests. Never development or production:
# setup applies all migrations and wipes its tables. Append ?sslmode=disable
# when the test server does not support TLS.
TEST_DATABASE_URL=postgresql://user:password@host:5432/fragtest
